# ── candela-sidecar ──
# Minimal production LLM proxy with Pub/Sub + OTLP span export.
# Target: <5MB static binary on distroless.
#
# Build:  docker build -f Dockerfile.sidecar -t candela-sidecar .
# Run:    docker run -p 8080:8080 -e GCP_PROJECT=my-project candela-sidecar

# golang:1.26-alpine
FROM golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder

RUN apk add --no-cache ca-certificates git

WORKDIR /app

# Cache dependencies.
COPY go.mod go.sum ./
RUN go mod download

# Copy source.
COPY . .

# Build static binary — CGO disabled, stripped, trimpath for reproducibility.
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -trimpath \
    -o /candela-sidecar \
    ./cmd/candela-sidecar/

# ── Runtime ──
# gcr.io/distroless/static-debian12:nonroot
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY --from=builder /candela-sidecar /candela-sidecar

# Default port (overridable via PORT env var).
EXPOSE 8080

ENTRYPOINT ["/candela-sidecar"]
