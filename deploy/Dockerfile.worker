# Build the Candela worker
# golang:1.26-alpine
FROM golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o candela-worker ./cmd/candela-worker

# Runtime
# alpine:3.20
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache ca-certificates
COPY --from=builder /build/candela-worker /usr/local/bin/candela-worker

# SECURITY: Run as non-root (CIS Docker Benchmark 4.1).
RUN addgroup -S candela && adduser -S -G candela candela
USER candela

ENTRYPOINT ["candela-worker"]
