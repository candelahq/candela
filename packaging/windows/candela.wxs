<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Candela"
    Manufacturer="Candela"
    Version="$(var.ProductVersion)"
    UpgradeCode="{D7B4C9A1-56F0-4F26-A0B2-6E5AF0F3812E}"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Candela is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="0" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Candela" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Candela" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="CandelaExeComponent" Guid="{758C2A21-0F43-4F47-BBE8-8920C2B4D723}">
        <File Id="CandelaExeFile" Source="$(var.SourceDir)\candela.exe" KeyPath="yes" />
        <Environment
          Id="CandelaPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      </Component>

      <Component Id="CandelaLicenseComponent" Guid="{9CC8FD6D-6B5F-4E8E-A883-B882C4B53166}">
        <File Id="CandelaLicenseFile" Source="$(var.SourceDir)\LICENSE.txt" KeyPath="yes" />
      </Component>

      <Component Id="CandelaReadmeComponent" Guid="{69A0839E-2789-4193-A7BE-6FF3EA893BA9}">
        <File Id="CandelaReadmeFile" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutsComponent" Guid="{9774C092-D853-448A-A67B-EA52FE02D6C3}">
        <Shortcut
          Id="CandelaStartShortcut"
          Name="Candela Start"
          Description="Start the Candela local proxy and embedded UI"
          Target="[INSTALLFOLDER]candela.exe"
          Arguments="start"
          WorkingDirectory="INSTALLFOLDER" />
        <Shortcut
          Id="CandelaUIShortcut"
          Name="Candela UI"
          Description="Open the Candela embedded management UI"
          Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
          Arguments="-NoProfile -WindowStyle Hidden -Command &quot;Start-Process 'http://127.0.0.1:8181/_local/'&quot;"
          WorkingDirectory="INSTALLFOLDER" />
        <Shortcut
          Id="CandelaStopShortcut"
          Name="Candela Stop"
          Description="Stop the Candela local proxy"
          Target="[INSTALLFOLDER]candela.exe"
          Arguments="stop"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Candela\Candela"
          Name="StartMenuShortcuts"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="{23219124-586E-41A2-9112-3EB54AFC285F}">
        <Condition>INSTALLDESKTOPSHORTCUT = "1"</Condition>
        <Shortcut
          Id="CandelaDesktopShortcut"
          Name="Candela"
          Description="Start Candela"
          Target="[INSTALLFOLDER]candela.exe"
          Arguments="start"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Candela\Candela"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Candela" Level="1">
      <ComponentRef Id="CandelaExeComponent" />
      <ComponentRef Id="CandelaLicenseComponent" />
      <ComponentRef Id="CandelaReadmeComponent" />
      <ComponentRef Id="StartMenuShortcutsComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
